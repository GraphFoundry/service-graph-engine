# ── Prometheus ───────────────────────────────────────────────
PROMETHEUS_URL=http://localhost:9090

# ── Neo4j Database ──────────────────────────────────────────
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# ── Kubernetes API (scheduler-extender proxy) ───────────────
KUBERNETES_API_URL=http://localhost:8005

# ── Application ─────────────────────────────────────────────
PORT=3000
# Sync interval: how often Prometheus is polled (ms)
POLL_INTERVAL_Ms=30000
# Score recalculation interval (ms)
SCORE_CALCULATION_INTERVAL_Ms=120000
# Kubernetes namespace used for overview queries
OVERVIEW_NAMESPACE=onlineboutique

# ── Webhook (push graph updates to subscribers) ─────────────
# Comma-separated subscriber URLs
WEBHOOK_URLS=http://localhost:7000/webhook/graph-update
# HMAC secret for signing payloads (must match subscriber's WEBHOOK_SECRET)
WEBHOOK_SECRET=change-me-to-a-random-hex-string
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_RETRY_MAX_ATTEMPTS=5
WEBHOOK_RETRY_BASE_DELAY_MS=250
WEBHOOK_RETRY_MAX_DELAY_MS=5000
